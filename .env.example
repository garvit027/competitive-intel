# Competitive Intelligence Platform - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED: API Keys
# =============================================================================

# SerpApi - Get free key at https://serpapi.com/manage-api-key (250 searches/month free)
CI_SERPAPI_API_KEY=your_serpapi_key_here

# OpenAI - Or use compatible provider (Anthropic, Azure, etc.)
CI_LLM_API_KEY=your_openai_key_here

# =============================================================================
# LLM Configuration
# =============================================================================

CI_LLM_PROVIDER=openai          # openai, anthropic, azure
CI_LLM_MODEL=gpt-4o-mini        # Model to use
CI_LLM_TEMPERATURE=0.1          # Lower = more deterministic
CI_LLM_MAX_TOKENS=4096
CI_LLM_TIMEOUT=60.0
CI_LLM_MAX_RETRIES=3

# For Azure OpenAI:
# CI_LLM_PROVIDER=azure
# CI_LLM_BASE_URL=https://your-resource.openai.azure.com
# CI_LLM_ORGANIZATION=your-org-id

# =============================================================================
# SerpApi Configuration
# =============================================================================

CI_SERPAPI_BASE_URL=https://serpapi.com
CI_SERPAPI_TIMEOUT=30.0
CI_SERPAPI_MAX_RETRIES=3
CI_SERPAPI_RATE_LIMIT_RPM=100       # Requests per minute (adjust for your plan)
CI_SERPAPI_DEFAULT_LOCATION=United States
CI_SERPAPI_DEFAULT_LANGUAGE=en
CI_SERPAPI_DEFAULT_COUNTRY=us
CI_SERPAPI_SAFE_SEARCH=true

# =============================================================================
# Cache Configuration
# =============================================================================

CI_CACHE_ENABLED=true
CI_CACHE_BACKEND=disk               # disk, memory, redis
CI_CACHE_DIRECTORY=.cache/serpapi
CI_CACHE_TTL_SECONDS=3600           # 1 hour default
CI_CACHE_MAX_SIZE_MB=500

# For Redis:
# CI_CACHE_BACKEND=redis
# CI_CACHE_REDIS_URL=redis://localhost:6379/0

# =============================================================================
# Observability Configuration
# =============================================================================

CI_OBS_ENABLED=true
CI_OBS_LOG_LEVEL=INFO               # DEBUG, INFO, WARNING, ERROR
CI_OBS_LOG_FORMAT=console           # json, console
CI_OBS_SERVICE_NAME=competitive-intel

# OpenTelemetry (optional)
# CI_OBS_OTLP_ENDPOINT=http://localhost:4317
CI_OBS_PROMETHEUS_PORT=9090
CI_OBS_TRACE_SAMPLE_RATE=0.1

# =============================================================================
# Database Configuration (for persistence)
# =============================================================================

CI_DB_URL=sqlite:///data/competitive_intel.db
CI_DB_ECHO=false
CI_DB_POOL_SIZE=5
CI_DB_MAX_OVERFLOW=10

# =============================================================================
# Report Configuration
# =============================================================================

CI_REPORT_OUTPUT_DIR=reports
CI_REPORT_TEMPLATE_DIR=templates
CI_REPORT_DEFAULT_FORMAT=markdown   # markdown, html, pdf
CI_REPORT_INCLUDE_CITATIONS=true
CI_REPORT_INCLUDE_RAW_DATA=false
CI_REPORT_MAX_REPORT_SIZE_MB=10

# =============================================================================
# Agent Behavior Configuration
# =============================================================================

CI_AGENT_MAX_ITERATIONS=10
CI_AGENT_MAX_SEARCH_RESULTS=10
CI_AGENT_SEARCH_TIMEOUT=30.0
CI_AGENT_ENABLE_HUMAN_IN_LOOP=false
CI_AGENT_CONFIDENCE_THRESHOLD=0.7
CI_AGENT_PARALLEL_SEARCHES=3

# =============================================================================
# Environment
# =============================================================================

ENVIRONMENT=development          # development, staging, production
DEBUG=false